; Dei in machina — progetto Godot 4
; Copyright (C) 2026 vonausterliz — GNU AGPL-3.0. Il testo della licenza e' in LICENSE;
; i componenti di terzi (GUT, il carattere Cardo) sono elencati in TERZE_PARTI.md.
; Fase 0: scaffolding. Nessuna scena principale ancora (UI = fase 8).

config_version=5

[application]

config/name="Dei in machina"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icona.png"
; Immagine d'avvio del motore, al posto del logo di Godot: e' lo stesso marchio della
; schermata d'apertura, generato da tools/genera_marchio.gd.
boot_splash/image="res://assets/marchio.png"
boot_splash/bg_color=Color(0.0745, 0.0627, 0.1255, 1)
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

PantheonManager="*res://autoload/pantheon_manager.gd"
GameManager="*res://autoload/game_manager.gd"
LLMManager="*res://autoload/llm_manager.gd"

[display]

window/size/viewport_width=1000
window/size/viewport_height=680

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
