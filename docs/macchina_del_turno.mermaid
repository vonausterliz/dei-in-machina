%% La macchina del turno — quadro narrativo e transizione atomica (fase 5).
%% Blu = chiamata LLM · beige = regola deterministica (GDScript).
%% Dettaglio completo: docs/architettura_dettaglio.md
flowchart TD
    A0["Inizio turno"] --> RC["RESA DEI CONTI - Zeus<br/>il sospetto sale sui pendenti"]
    RC --> RCQ{"sospetto<br/>>= soglia?"}
    RCQ -->|si| RET["ZEUS scopre il colpevole<br/>ira in relazioni.zeus_verso<br/>+ rimbalzo su Ulisse"]
    RCQ -->|no| A
    RET --> A

    A["Ulisse scrive - testo libero"] --> SEG["segna_turno: azione + momento<br/>(il collante fra le tre viste)"]
    SEG --> B["INTERPRETE<br/>testo + parole dette ai compagni<br/>-> envelope JSON"]
    B --> VQ{"e' uno spunto<br/>gia' offerto?"}
    VQ -->|si| C
    VQ -->|no| VAG["VAGLIO - secondo parere<br/>una domanda secca, temp 0"]
    VAG --> C{"plausibilita<br/>= in_mondo?"}

    C -->|no| D["Ammonizione +1<br/>turni_puliti = 0"]
    D --> E{"contatore >= soglia?"}
    E -->|si| F["FOLLIA - un dio colpisce"]
    E -->|no| AP
    F --> AP

    C -->|si| H["turni_puliti +1<br/>decadimento ammonizioni<br/>+ delta della sola azione"]
    H --> EV["registra eventi accaduti<br/>(emette_su_tag: restano per sempre)"]
    EV --> INV["risoluzione INVOCAZIONE<br/>1 envelope · 2 nome/epiteto · 3 LLM"]
    INV --> I["RISVEGLIO - regola<br/>attivo -> dorme_finche -> fascia<br/>-> trigger_azione / trigger_evento / dio_invocato"]
    I --> J{"quanti dei<br/>si destano?"}
    J -->|nessuno| COA
    J -->|uno o piu| M["DELIBERAZIONE round 1<br/>una proposta per dio<br/>registro · intensita · battuta"]
    M --> SIL["si scartano i 'silenzio'"]
    SIL --> J2{"voci in campo?"}
    J2 -->|0| COA
    J2 -->|1| DET
    J2 -->|"2 o piu"| L["REPLICHE - round 2<br/>ognuno rilegge gli altri e ribatte<br/>tetto: MAX_REPLICHE = 2"]
    L --> K{"conflitto?<br/>chi punisce E chi aiuta"}
    K -->|no| DET["Verdetto deterministico<br/>vince la piu' intensa<br/>+ riga di servizio in chat"]
    K -->|si| AR["ARBITRO Zeus<br/>chiude con parole SUE"]

    DET --> MOD
    AR --> MOD["modulazione: piano · hybris<br/>· peso di coalizione"]
    MOD --> SCQ{"un dio punitivo bocciato<br/>tenta lo scavalcamento?"}
    SCQ -->|si| SCB["SCAVALCAMENTO occulto<br/>delta nascosto + pendente"]
    SCQ -->|no| MEM
    SCB --> MEM["ogni dio ANNOTA nel taccuino<br/>cosa ha voluto e come e' finita"]
    MEM --> COA["coalizioni: decadono,<br/>raramente se ne forma una"]
    COA --> AP["APPLICA il delta - regola<br/>ulisse · registro divino · relazioni"]
    AP --> ES["ESITO della tappa prima<br/>prigionia · ciurma · follia"]
    ES --> MONDO{"turno in-mondo?"}
    MONDO -->|no| G["Richiamo diegetico<br/>OMERO NON viene chiamato"]
    G --> CIU
    MONDO -->|si| CONT{"esito continua?"}
    CONT -->|no| Q
    CONT -->|si| AV{"Viaggio chiude la tappa?<br/>tag (rotta vuole movimento)<br/>o pressione dopo il grado 3"}
    AV -->|si| NEXT["applica l'unica tappa successiva<br/>causa: scelta | cacciato | prodigio<br/>chi deve cadere, cade e tace"]
    AV -->|no| Q
    NEXT --> Q["QUADRO AUTOREVOLE<br/>stato prima · azione · conseguenze<br/>stato dopo · passaggio da/a/causa"]
    Q --> NAR["OMERO narra azione + passaggio<br/>UNA voce + 3 spunti"]

    NAR --> FIL["FILTRO SPUNTI<br/>impalcatura (anche in grassetto) · anacronismi<br/>non_ancora · forma ripulita<br/>vuoto -> spunti_di_riserva DELLA TAPPA"]
    FIL --> CIU["LA CIURMA commenta<br/>(chi e' interpellato, o uno a rotazione)"]
    CIU --> REG["registra: storico_olimpo + diario"]
    REG --> FINE{"esito del turno"}
    FINE -->|itaca| WIN["VITTORIA"]
    FINE -->|"morte / ciurma 0 / prigionia / follia"| LOSE["SCONFITTA"]
    FINE -->|continua| CRON{"turni dall'ultima<br/>cronaca >= N?"}
    CRON -->|si| CR["CRONISTA: aggiorna il riassunto"]
    CRON -->|no| A2["Prossima scena"]
    CR --> A2
    A2 --> A0

    BEAT["BEAT - Ulisse scrive nella chat della ciurma<br/>1 chiamata sola: il mondo NON gira<br/>le parole restano in sospeso per il turno vero"] -.-> B

    classDef llm fill:#26324d,stroke:#5b7fb5,color:#eaf0fb,stroke-width:1px;
    classDef logic fill:#f0ede6,stroke:#b9ae93,color:#2a2620;
    classDef win fill:#dcefdc,stroke:#4a8b5a,color:#1e3a24;
    classDef lose fill:#f3dcd6,stroke:#b0503a,color:#4a1e14;
    classDef fine fill:#e6e6ea,stroke:#8b93ad,color:#2a2a33;

    class B,VAG,M,L,AR,NAR,CIU,CR llm;
    class D,H,I,AP,ES,AV,NEXT,Q,A2,RC,SCB,SEG,EV,INV,SIL,DET,MOD,MEM,COA,FIL,REG logic;
    class WIN win;
    class F,LOSE lose;
    class G,BEAT fine;
